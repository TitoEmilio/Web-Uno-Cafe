  class="fixed bottom-24 right-4 md:bottom-8 md:right-8 z-40 w-12 h-12 md:w-14 md:h-14 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-[0_16px_36px_-8px_rgba(33,29,26,0.18),0_4px_12px_-2px_rgba(33,29,26,0.08)] active:scale-95 md:hover:scale-105 md:hover:shadow-2xl transition-all duration-200"
  href={href}
  rel="noopener noreferrer"
  target="_blank"
>
