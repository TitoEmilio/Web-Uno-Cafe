---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Uno Café · Ubicación & Horarios (Lo Cañas, La Florida)"
  description="Strip Center Lo Cañas, Local 18. Horarios de atención, mapas, rutas, estacionamiento gratuito y preguntas frecuentes."
>
  <!-- Encabezado de Ubicación -->
  <section class="max-w-7xl mx-auto w-full px-margin-mobile md:px-8 pt-space-lg md:pt-12 pb-space-md md:pb-8 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
    <div class="flex flex-col gap-space-xs md:max-w-2xl">
      <div class="inline-flex items-center gap-1.5 self-start px-3 py-1 rounded-full bg-warm-ecru text-on-surface-variant font-label-sm text-label-sm tracking-widest uppercase shadow-sm border border-muted-border/30">
        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
        Guía de visita &amp; accesos
      </div>
      <h1 class="font-headline-lg-mobile md:font-headline-xl text-headline-lg-mobile md:text-headline-xl text-primary tracking-tight font-normal leading-tight font-serif mt-1">
        Encuentra tu refugio en Lo Cañas, La Florida.
      </h1>
      <p class="font-body-md md:font-body-lg text-body-md md:text-body-lg text-on-surface-variant leading-relaxed">
        Coordina tu pausa diaria en un espacio diseñado para bajar el ritmo. Ya sea para un espresso matutino antes de subir al cerro o una tarde de lectura con repostería artesanal.
      </p>
    </div>
    <!-- Live Status Banner -->
    <div class="mt-space-xs md:mt-0 p-space-sm md:p-4 rounded-xl md:rounded-2xl bg-warm-ecru/90 text-espresso-deep flex items-center gap-3 shadow-sm md:w-80 shrink-0 border border-muted-border/40">
      <span class="relative flex h-2.5 w-2.5 shrink-0">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-600"></span>
      </span>
      <div class="flex flex-col min-w-0">
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="font-label-md text-label-md text-espresso-deep font-semibold">ABIERTO AHORA</span>
          <span class="text-on-surface-variant/40">·</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant">Cierra a las 19:00 hrs</span>
        </div>
        <span class="font-label-sm text-label-sm text-secondary truncate">Strip Center Lo Cañas · Local 18</span>
      </div>
    </div>
  </section>

  <!-- Imagen Principal de la Fachada -->
  <section class="max-w-7xl mx-auto w-full px-margin-mobile md:px-8 pb-space-md md:pb-8">
    <div class="relative w-full rounded-xl md:rounded-2xl overflow-hidden shadow-md bg-warm-ecru aspect-[4/3] md:aspect-[21/9] md:h-[400px] group">
      <img
        alt="Fachada exterior y terraza de uno café en Lo Cañas"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        src="public/images/imagen4.jpeg"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-espresso-deep/60 via-transparent to-transparent"></div>
      <div class="absolute bottom-3 md:bottom-5 left-3 md:left-5 right-3 md:right-5 flex items-center justify-between text-surface-container-lowest">
        <div class="flex items-center gap-2 backdrop-blur-md bg-espresso-deep/50 px-3 py-1.5 rounded-full">
          <span class="material-symbols-outlined text-[18px] text-secondary-container">deck</span>
          <span class="font-label-sm text-label-sm text-on-primary font-medium">Terraza exterior habilitada</span>
        </div>
        <span class="font-label-sm text-label-sm backdrop-blur-md bg-espresso-deep/50 px-3 py-1.5 rounded-full font-medium">Pet Friendly</span>
      </div>
    </div>
  </section>

  <!-- Botones de Acción Táctil Inmediata -->
  <section class="max-w-7xl mx-auto w-full px-margin-mobile md:px-8 pb-space-lg md:pb-12">
    <div class="grid grid-cols-3 gap-2 md:gap-6">
      <a
        class="flex flex-col items-center justify-center p-3 md:p-5 rounded-xl md:rounded-2xl bg-warm-ecru text-on-surface hover:bg-soft-linen active:scale-95 md:hover:-translate-y-1 transition-all text-center gap-1.5 shadow-sm border border-muted-border/30"
        href="https://maps.google.com/?q=Lo+Cañas+3517+La+Florida"
        rel="noopener noreferrer"
        target="_blank"
      >
        <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-sm">
          <span class="material-symbols-outlined text-[20px] md:text-[24px]">near_me</span>
        </div>
        <span class="font-title-md text-title-md text-primary text-[14px] md:text-base font-semibold">Google Maps</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant line-clamp-1">Ruta directa</span>
      </a>
      <a
        class="flex flex-col items-center justify-center p-3 md:p-5 rounded-xl md:rounded-2xl bg-warm-ecru text-on-surface hover:bg-soft-linen active:scale-95 md:hover:-translate-y-1 transition-all text-center gap-1.5 shadow-sm border border-muted-border/30"
        href="https://waze.com/ul?q=Lo+Cañas+3517+La+Florida"
        rel="noopener noreferrer"
        target="_blank"
      >
        <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-secondary text-on-secondary flex items-center justify-center shadow-sm">
          <span class="material-symbols-outlined text-[20px] md:text-[24px]">directions_car</span>
        </div>
        <span class="font-title-md text-title-md text-primary text-[14px] md:text-base font-semibold">Waze</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant line-clamp-1">Tráfico en vivo</span>
      </a>
      <a
        class="flex flex-col items-center justify-center p-3 md:p-5 rounded-xl md:rounded-2xl bg-warm-ecru text-on-surface hover:bg-soft-linen active:scale-95 md:hover:-translate-y-1 transition-all text-center gap-1.5 shadow-sm border border-muted-border/30"
        href="https://wa.me/56985006041"
        rel="noopener noreferrer"
        target="_blank"
      >
        <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#25D366] text-white flex items-center justify-center shadow-sm">
          <span class="material-symbols-outlined text-[20px] md:text-[24px]">chat</span>
        </div>
        <span class="font-title-md text-title-md text-primary text-[14px] md:text-base font-semibold">WhatsApp</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant line-clamp-1">Consultas rápidas</span>
      </a>
    </div>
  </section>

  <!-- Tarjetas Informativas de Horarios y Dirección en 2 Columnas -->
  <section class="max-w-7xl mx-auto w-full px-margin-mobile md:px-8 pb-space-lg md:pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 items-stretch">
      <!-- Horarios -->
      <div class="bg-surface-container-low p-space-md md:p-8 rounded-xl md:rounded-2xl shadow-sm border border-muted-border/30 flex flex-col justify-between gap-space-sm">
        <div class="flex flex-col gap-space-sm">
          <div class="flex items-center gap-2.5 text-primary">
            <span class="material-symbols-outlined text-[24px] text-secondary">schedule</span>
            <h2 class="font-headline-sm md:font-headline-md text-headline-sm md:text-headline-md tracking-tight text-primary">Horarios de Atención</h2>
          </div>
          <div class="flex flex-col gap-2.5 pt-1 font-body-md text-body-md">
            <div class="flex justify-between items-center py-2 bg-surface/70 px-4 rounded-xl border border-muted-border/20">
              <span class="text-on-surface font-medium">Lunes a Viernes</span>
              <span class="text-primary font-semibold font-title-md text-title-md">08:00 – 19:00</span>
            </div>
            <div class="flex justify-between items-center py-2 bg-surface/70 px-4 rounded-xl border border-muted-border/20">
              <span class="text-on-surface font-medium">Sábado</span>
              <span class="text-primary font-semibold font-title-md text-title-md">10:00 – 19:00</span>
            </div>
            <div class="flex justify-between items-center py-2 bg-surface/70 px-4 rounded-xl border border-muted-border/20">
              <div class="flex items-center gap-2">
                <span class="text-on-surface font-medium">Domingo</span>
                <span class="px-2 py-0.5 bg-secondary-container text-on-secondary-container font-label-sm text-xs rounded-full font-semibold">Medio día</span>
              </div>
              <span class="text-primary font-semibold font-title-md text-title-md">10:00 – 14:00</span>
            </div>
          </div>
        </div>
        <div class="mt-2 pt-3 border-t border-muted-border/30 flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm">
          <span class="material-symbols-outlined text-[18px] text-secondary shrink-0">info</span>
          <span>Cocina y barra de especialidad cierran 15 minutos antes del horario anunciado.</span>
        </div>
      </div>

      <!-- Dirección & Entorno -->
      <div class="bg-surface-container-low p-space-md md:p-8 rounded-xl md:rounded-2xl shadow-sm border border-muted-border/30 flex flex-col gap-space-sm">
        <div class="flex items-center gap-2.5 text-primary">
          <span class="material-symbols-outlined text-[24px] text-terracotta">pin_drop</span>
          <h2 class="font-headline-sm md:font-headline-md text-headline-sm md:text-headline-md tracking-tight text-primary">Dirección &amp; Entorno</h2>
        </div>
        <div class="flex flex-col gap-1">
          <p class="font-title-md md:font-title-lg text-title-md md:text-title-lg text-primary leading-snug font-semibold">Strip Center Lo Cañas, Local 18</p>
          <p class="font-body-md text-body-md text-on-surface-variant">Lo Cañas 3517, La Florida, Santiago de Chile</p>
        </div>
        <!-- Puntos Clave del Entorno -->
        <div class="grid grid-cols-1 gap-2.5 pt-2">
          <div class="flex items-start gap-3 p-3.5 bg-surface rounded-xl shadow-sm border border-muted-border/20">
            <div class="w-9 h-9 rounded-full bg-warm-ecru flex items-center justify-center shrink-0 mt-0.5 text-secondary shadow-sm">
              <span class="material-symbols-outlined text-[18px]">local_parking</span>
            </div>
            <div>
              <p class="font-title-md text-title-md text-[15px] text-primary font-medium">+35 Estacionamientos gratuitos</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">Acceso controlado, amplio y seguro dentro del Strip Center.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-3.5 bg-surface rounded-xl shadow-sm border border-muted-border/20">
            <div class="w-9 h-9 rounded-full bg-warm-ecru flex items-center justify-center shrink-0 mt-0.5 text-secondary shadow-sm">
              <span class="material-symbols-outlined text-[18px]">nature</span>
            </div>
            <div>
              <p class="font-title-md text-title-md text-[15px] text-primary font-medium">Ruta Bosque Panul</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">A minutos de la entrada a senderos ecológicos y ciclorrutas de Av. Central.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-3.5 bg-surface rounded-xl shadow-sm border border-muted-border/20">
            <div class="w-9 h-9 rounded-full bg-warm-ecru flex items-center justify-center shrink-0 mt-0.5 text-secondary shadow-sm">
              <span class="material-symbols-outlined text-[18px]">accessible</span>
            </div>
            <div>
              <p class="font-title-md text-title-md text-[15px] text-primary font-medium">Accesibilidad Total</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">Nivel de calle, sin desniveles pronunciados y baño adaptado.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Plano de Ubicación -->
  <section class="max-w-7xl mx-auto w-full px-margin-mobile md:px-8 pb-space-lg md:pb-16 flex flex-col gap-space-xs">
    <div class="flex items-center justify-between pb-1">
      <span class="font-title-md md:font-title-lg text-title-md md:text-title-lg text-primary font-semibold">Plano de Ubicación</span>
      <span class="font-label-sm text-label-sm text-secondary uppercase font-semibold">Sector Precordillera</span>
    </div>
    <div class="relative w-full rounded-xl md:rounded-2xl overflow-hidden shadow-md bg-warm-ecru h-64 md:h-96 group">
      <div
        class="w-full h-full bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuADUtSWfb75zitdtme0tHE_ZyNZVh6nauQtkiri-YaOIVHAYTFR3H1OwYhje5G9DgGXCh_GqDfxG9WeoGRYheraRfUX1_UYHS39mOSBsOfr0cIMnnf7QS4_XWO4eZgUkYPiUlx6uOMavW4IEi66FQmYs2QM-HfLt9Qa8qd4g3Luzvk6M1Zndywy2z03kr2YRDvsYFBAhL1mQw-D3ekRqvTtYO0RkE0_kbNmwzPunr5mcdvJ4W5aDNI');"
      ></div>
      <!-- Badge de Punto Geográfico flotante -->
      <div class="absolute bottom-3 md:bottom-5 left-3 md:left-5 right-3 md:right-5 bg-surface/95 backdrop-blur-md p-3.5 md:p-4 rounded-xl md:rounded-2xl shadow-lg flex items-center justify-between border border-muted-border/30 max-w-lg">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-9 h-9 md:w-10 md:h-10 rounded-full bg-primary text-on-primary flex items-center justify-center shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[18px] md:text-[20px]">coffee</span>
          </div>
          <div class="truncate">
            <p class="font-title-md text-title-md text-[14px] md:text-[15px] text-primary truncate leading-tight font-semibold">uno café · Local 18</p>
            <p class="font-label-sm text-label-sm text-on-surface-variant truncate">Strip Center Lo Cañas</p>
          </div>
        </div>
        <a
          class="shrink-0 px-4 py-2 rounded-full bg-primary text-on-primary font-label-md text-xs md:text-sm font-semibold active:scale-95 md:hover:scale-105 transition-all shadow-sm"
          href="https://maps.google.com/?q=Lo+Cañas+3517+La+Florida"
          rel="noopener noreferrer"
          target="_blank"
        >
          Cómo llegar
        </a>
      </div>
    </div>
    <span class="font-label-sm text-label-sm text-on-surface-variant/80 px-1 pt-1.5">
      Acceso fluido desde Av. Departamental, Rojas Magallanes y Av. Tobalaba.
    </span>
  </section>

  <!-- Preguntas Frecuentes (Acordeón Táctil) -->
  <section class="max-w-4xl mx-auto w-full px-margin-mobile md:px-8 pb-space-xl md:pb-24 flex flex-col gap-space-md">
    <div class="flex flex-col gap-1 text-center md:text-left">
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest font-semibold">Dudas comunes</span>
      <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary font-normal font-serif">
        Todo lo que necesitas saber antes de venir
      </h2>
    </div>
    <!-- Accordion Items -->
    <div class="flex flex-col gap-2.5 md:gap-3" id="faq-accordion">
      <!-- Item 1 -->
      <div class="faq-item rounded-xl md:rounded-2xl bg-surface-container-low overflow-hidden transition-all shadow-sm border border-muted-border/30">
        <button
          aria-expanded="true"
          class="faq-btn w-full flex items-center justify-between p-space-sm md:p-5 text-left gap-3 focus:outline-none cursor-pointer"
        >
          <span class="font-title-md md:font-title-lg text-title-md md:text-title-lg text-primary font-medium">¿Cuentan con estacionamiento para clientes?</span>
          <span class="material-symbols-outlined text-[20px] text-secondary transition-transform duration-200 transform rotate-180 shrink-0">expand_more</span>
        </button>
        <div class="faq-content px-space-sm md:px-5 pb-space-sm md:pb-5 text-on-surface-variant font-body-md text-body-md block leading-relaxed">
          Sí, disponemos de más de 35 plazas de estacionamiento gratuitas y pavimentadas dentro del Strip Center Lo Cañas, con vigilancia y cámaras las 24 horas del día.
        </div>
      </div>
      <!-- Item 2 -->
      <div class="faq-item rounded-xl md:rounded-2xl bg-surface-container-low overflow-hidden transition-all shadow-sm border border-muted-border/30">
        <button
          aria-expanded="false"
          class="faq-btn w-full flex items-center justify-between p-space-sm md:p-5 text-left gap-3 focus:outline-none cursor-pointer"
        >
          <span class="font-title-md md:font-title-lg text-title-md md:text-title-lg text-primary font-medium">¿Qué medios de pago aceptan?</span>
          <span class="material-symbols-outlined text-[20px] text-secondary transition-transform duration-200 shrink-0">expand_more</span>
        </button>
        <div class="faq-content px-space-sm md:px-5 pb-space-sm md:pb-5 text-on-surface-variant font-body-md text-body-md hidden leading-relaxed">
          Aceptamos tarjetas de débito, crédito (Visa, Mastercard, American Express), transferencias bancarias y efectivo. También admitimos pago móvil sin contacto (Apple Pay y Google Wallet).
        </div>
      </div>
      <!-- Item 3 -->
      <div class="faq-item rounded-xl md:rounded-2xl bg-surface-container-low overflow-hidden transition-all shadow-sm border border-muted-border/30">
        <button
          aria-expanded="false"
          class="faq-btn w-full flex items-center justify-between p-space-sm md:p-5 text-left gap-3 focus:outline-none cursor-pointer"
        >
          <span class="font-title-md md:font-title-lg text-title-md md:text-title-lg text-primary font-medium">¿Disponen de alternativas veganas o sin gluten?</span>
          <span class="material-symbols-outlined text-[20px] text-secondary transition-transform duration-200 shrink-0">expand_more</span>
        </button>
        <div class="faq-content px-space-sm md:px-5 pb-space-sm md:pb-5 text-on-surface-variant font-body-md text-body-md hidden leading-relaxed">
          ¡Por supuesto! Contamos con bebidas vegetales (avena y almendra sin recargo excesivo), opciones dulces sin azúcar refinada y bollería seleccionada apta para dietas veganas y celíacas. Consulta a nuestros baristas al ordenar.
        </div>
      </div>
      <!-- Item 4 -->
      <div class="faq-item rounded-xl md:rounded-2xl bg-surface-container-low overflow-hidden transition-all shadow-sm border border-muted-border/30">
        <button
          aria-expanded="false"
          class="faq-btn w-full flex items-center justify-between p-space-sm md:p-5 text-left gap-3 focus:outline-none cursor-pointer"
        >
          <span class="font-title-md md:font-title-lg text-title-md md:text-title-lg text-primary font-medium">¿Tienen conexión Wi-Fi de alta velocidad?</span>
          <span class="material-symbols-outlined text-[20px] text-secondary transition-transform duration-200 shrink-0">expand_more</span>
        </button>
        <div class="faq-content px-space-sm md:px-5 pb-space-sm md:pb-5 text-on-surface-variant font-body-md text-body-md hidden leading-relaxed">
          Sí, ofrecemos Wi-Fi de fibra óptica dedicado y gratuito para clientes, ideal para nómadas digitales o reuniones de trabajo tranquilas en nuestras mesas interiores con enchufes cercanos.
        </div>
      </div>
    </div>
  </section>


  <!-- Script para Interacción del Acordeón -->
  <script>
    function setupFaq() {
      const buttons = document.querySelectorAll<HTMLButtonElement>('.faq-btn');
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const parent = btn.closest('.faq-item');
          if (!parent) return;
          const content = parent.querySelector('.faq-content');
          const icon = btn.querySelector('.material-symbols-outlined');
          const isExpanded = btn.getAttribute('aria-expanded') === 'true';

          if (isExpanded) {
            content?.classList.add('hidden');
            content?.classList.remove('block');
            btn.setAttribute('aria-expanded', 'false');
            icon?.classList.remove('rotate-180');
          } else {
            content?.classList.remove('hidden');
            content?.classList.add('block');
            btn.setAttribute('aria-expanded', 'true');
            icon?.classList.add('rotate-180');
          }
        });
      });
    }

    setupFaq();
    document.addEventListener('astro:page-load', setupFaq);
  </script>
</Layout>
